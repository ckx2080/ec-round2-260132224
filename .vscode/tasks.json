{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "Debug"],
      "problemMatcher": []
    },
    {
      "label": "cmake: build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cmake: build (Release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Release"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "clean rebuild",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug", "--clean-first"],
      "problemMatcher": ["$gcc"]
    }
  ]
}
